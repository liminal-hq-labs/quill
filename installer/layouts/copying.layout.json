{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "copying",
	"root": {
		"kind": "window",
		"props": {
			"title": "{product.name} Setup",
			"label": "Installing",
			"style": "neutral"
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 1
				},
				"children": [
					{
						"kind": "stack",
						"props": {
							"direction": "column",
							"gap": 0,
							"group": "lead"
						},
						"children": [
							{
								"kind": "text",
								"props": {
									"text": "Installing {product.name}",
									"role": "heading",
									"icon": {
										"viewBox": [
											24,
											24
										],
										"shapes": [
											{
												"path": "M12 3l8 4v10l-8 4-8-4V7zM4 7l8 4 8-4M12 11v10",
												"stroke": "#1d4ed8",
												"width": 1.6,
												"join": "round"
											}
										]
									}
								}
							},
							{
								"kind": "text",
								"props": {
									"text": "This takes a minute or two. You can keep working.",
									"role": "body"
								}
							}
						]
					},
					{
						"kind": "meter",
						"bind": "engine.meter.file",
						"props": {
							"label": "Current file",
							"source": "file",
							"caption": "{progress.file}"
						}
					},
					{
						"kind": "meter",
						"bind": "engine.meter.total",
						"props": {
							"label": "Overall progress",
							"source": "total",
							"caption": "{progress.percent}%"
						}
					},
					{
						"kind": "meter",
						"bind": "engine.meter.free_space",
						"props": {
							"label": "Free space after install",
							"source": "free_space",
							"warn_label": "Low",
							"low_below": 0.05,
							"caption": "{system.free_space_after}"
						}
					},
					{
						"kind": "stack",
						"props": {
							"direction": "column",
							"gap": 0,
							"group": "tasks"
						},
						"children": [
							{
								"kind": "text",
								"props": {
									"text": "Copying files",
									"role": "task",
									"state": "current"
								}
							},
							{
								"kind": "text",
								"props": {
									"text": "Adding shortcuts and file types",
									"role": "task",
									"state": "todo"
								}
							},
							{
								"kind": "text",
								"props": {
									"text": "Registering with the system, so you can update or remove it later",
									"role": "task",
									"state": "todo"
								}
							}
						]
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 2,
					"align": "end",
					"region": "footer"
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Cancel puts everything back as it was.",
							"role": "note"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Cancel",
							"action": "cancel"
						}
					}
				]
			}
		]
	}
}
