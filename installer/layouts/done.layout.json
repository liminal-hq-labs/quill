{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "done",
	"root": {
		"kind": "window",
		"props": {
			"title": "{product.name} Setup",
			"label": "Done",
			"style": "neutral"
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 1
				},
				"children": [
					{
						"kind": "stack",
						"props": {
							"direction": "column",
							"gap": 0,
							"group": "lead"
						},
						"children": [
							{
								"kind": "text",
								"props": {
									"text": "{product.name} is ready",
									"role": "heading",
									"icon": {
										"viewBox": [
											24,
											24
										],
										"shapes": [
											{
												"path": "M12 3l8 4v10l-8 4-8-4V7zM4 7l8 4 8-4M12 11v10",
												"stroke": "#1d4ed8",
												"width": 1.6,
												"join": "round"
											}
										]
									}
								}
							},
							{
								"kind": "text",
								"props": {
									"text": "Setup is complete. Thank you for installing it.",
									"role": "body"
								}
							}
						]
					},
					{
						"kind": "checklist",
						"bind": "finish.launch",
						"props": {
							"label": "After setup",
							"items": [
								{
									"id": "launch",
									"label": "Start {product.name}"
								}
							]
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 2,
					"align": "end",
					"region": "footer"
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "{product.name} {product.version} is installed.",
							"role": "note"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Finish",
							"action": "finish",
							"default": true
						}
					}
				]
			}
		]
	}
}
