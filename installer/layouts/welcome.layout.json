{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "welcome",
	"root": {
		"kind": "window",
		"props": {
			"title": "{product.name} Setup",
			"label": "Welcome",
			"style": "neutral"
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 1
				},
				"children": [
					{
						"kind": "stack",
						"props": {
							"direction": "column",
							"gap": 0,
							"group": "lead"
						},
						"children": [
							{
								"kind": "text",
								"props": {
									"text": "Welcome to {product.name}",
									"role": "heading",
									"icon": {
										"viewBox": [
											24,
											24
										],
										"shapes": [
											{
												"path": "M12 3l8 4v10l-8 4-8-4V7zM4 7l8 4 8-4M12 11v10",
												"stroke": "#1d4ed8",
												"width": 1.6,
												"join": "round"
											}
										]
									}
								}
							},
							{
								"kind": "text",
								"props": {
									"text": "This takes a minute or two. Setup puts everything back as it was if you cancel.",
									"role": "body"
								}
							}
						]
					},
					{
						"kind": "text",
						"props": {
							"text": "Version {product.version} · {target.id}",
							"role": "caption"
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 2,
					"align": "end",
					"region": "footer"
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Installs for you only · no administrator needed",
							"role": "note"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Next",
							"action": "next",
							"default": true
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Cancel",
							"action": "cancel"
						}
					}
				]
			}
		]
	}
}
