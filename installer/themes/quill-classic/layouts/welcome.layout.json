{
	"$schema": "https://liminal-hq.github.io/installer/schema/layout.json",
	"version": 1,
	"id": "welcome",
	"root": {
		"kind": "dialog",
		"props": {
			"title": "Welcome",
			"label": "Welcome",
			"style": "win32-classic",
			"width": 64
		},
		"children": [
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 0,
					"region": "side"
				},
				"children": [
					{
						"kind": "image",
						"props": {
							"label": "Product",
							"alt": "Product",
							"art": {
								"width": 14,
								"height": 14,
								"scale": 8,
								"rects": [
									[
										1,
										4,
										12,
										9,
										"#c0c0c0"
									],
									[
										1,
										4,
										12,
										1,
										"#ffffff"
									],
									[
										1,
										12,
										12,
										1,
										"#404040"
									],
									[
										1,
										8,
										12,
										1,
										"#808080"
									],
									[
										5,
										1,
										4,
										3,
										"#ffff55"
									],
									[
										4,
										4,
										6,
										1,
										"#dfdfdf"
									],
									[
										11,
										5,
										2,
										2,
										"#00aaaa"
									]
								]
							},
							"panel": "#008080",
							"ground": "#004040"
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "column",
					"gap": 1
				},
				"children": [
					{
						"kind": "text",
						"props": {
							"text": "Welcome to the {product.name} Setup program. This program will install {product.name} on your computer.",
							"role": "body"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "It is strongly recommended that you exit all other programs before running this Setup program.",
							"role": "body"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Click Cancel to quit Setup and close any programs you have running. Click Next to continue with the Setup program.",
							"role": "body"
						}
					},
					{
						"kind": "text",
						"props": {
							"text": "Version {product.version}",
							"role": "caption"
						}
					}
				]
			},
			{
				"kind": "stack",
				"props": {
					"direction": "row",
					"gap": 1,
					"align": "end",
					"region": "footer"
				},
				"children": [
					{
						"kind": "button",
						"props": {
							"label": "Next",
							"action": "next",
							"default": true,
							"hotkey": "N"
						}
					},
					{
						"kind": "button",
						"props": {
							"label": "Cancel",
							"action": "cancel"
						}
					}
				]
			}
		]
	}
}
