[Desktop Entry]
Type=Application
Name=Quill
GenericName=Word Processor
Comment=Write and edit Quill, Rich Text and plain text documents
Exec=quill %F
Icon=io.github.liminal_hq_labs.Quill
Terminal=false
StartupNotify=true
StartupWMClass=io.github.liminal_hq_labs.Quill
DBusActivatable=false
Categories=Office;WordProcessor;GTK;
MimeType=application/x-quill-document;application/rtf;text/rtf;text/plain;
Keywords=word;document;rtf;text;
