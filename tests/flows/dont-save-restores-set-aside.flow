# Don't Save removes this session's copy and brings the set-aside copy back, so the work left alone at Open is where it was.
@recovery
@file "C:\\DOCS\\LETTER.QLD" "dear sir"
cmd Open
choose "C:\\DOCS\\LETTER.QLD"
type ", and madam"
autosave
restart
expect recover default Yes
answer later
cmd Open
expect file Open
choose "C:\\DOCS\\LETTER.QLD"
expect recover buttons=RecoverOriginalDiscard
cancel
type " yours"
@clock +600s
autosave
dump
cmd New
expect ask "Save the changes to C:\\DOCS\\LETTER.QLD before a new document starts?" default Yes
answer No
dump
