# After Open original the copy is left alone; the first autosave that follows sets it aside, so at most two copies exist, and a Save removes both.
@recovery
@file "C:\\DOCS\\LETTER.QLD" "dear sir"
cmd Open
choose "C:\\DOCS\\LETTER.QLD"
type ", and madam"
autosave
restart
expect recover default Yes
answer later
cmd Open
expect file Open
choose "C:\\DOCS\\LETTER.QLD"
expect recover buttons=RecoverOriginalDiscard
cancel
type " yours"
@clock +600s
autosave
dump
@clock +600s
type " truly"
autosave
dump
cmd Save
dump
