# A document whose only copy is the set-aside one still offers it, with the words for an older copy.
@recovery
@file "C:\\DOCS\\LETTER.QLD" "dear sir"
cmd Open
choose "C:\\DOCS\\LETTER.QLD"
type ", and madam"
autosave
restart
expect recover default Yes
answer later
cmd Open
expect file Open
choose "C:\\DOCS\\LETTER.QLD"
expect recover buttons=RecoverOriginalDiscard
cancel
type " yours"
@clock +600s
autosave
rm "C:\\DOCS\\~LETT941.RCV"
restart
expect recover "An older recovered copy of LETTER.QLD exists, from 25 Nov 2026 at 2:32 PM." buttons=RecoverDiscardLater
answer later
cmd Open
expect file Open
choose "C:\\DOCS\\LETTER.QLD"
expect recover "An older recovered copy of LETTER.QLD exists, from 25 Nov 2026 at 2:32 PM." buttons=RecoverOriginalDiscard
answer recover
dump
