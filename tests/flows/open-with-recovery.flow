# Opening a document that has a recovery copy asks first: Esc opens the original and keeps the copy, Discard removes it, Recover opens it.
@recovery
@file "C:\\DOCS\\LETTER.QLD" "dear sir"
cmd Open
choose "C:\\DOCS\\LETTER.QLD"
type ", and madam"
autosave
restart
expect recover default Yes
answer later
cmd Open
expect file Open
choose "C:\\DOCS\\LETTER.QLD"
expect recover "LETTER.QLD has changes that were not saved, from 25 Nov 2026 at 2:32 PM." buttons=RecoverOriginalDiscard default Yes
cancel
dump
cmd Open
expect file Open
choose "C:\\DOCS\\LETTER.QLD"
expect recover buttons=RecoverOriginalDiscard
answer discard
dump
type " and so on"
autosave
cmd Open
expect ask default Yes
answer No
expect file Open
choose "C:\\DOCS\\LETTER.QLD"
expect recover buttons=RecoverOriginalDiscard
answer recover
dump
