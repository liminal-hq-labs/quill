# Tabs: the dialog stays open; a position that is not inches is a box; a seventeenth stop is a line for the status bar.
type "tabbed"
cmd Tabs
expect dialog Tabs
tabs set "abc"
expect notice "Type a position in inches, such as 1.25." Warn
tabs set "1.25" kind=1 leader=1
tabs set "0.50"
dump
tabs clear "1.25"
dump
tabs set "2.5" kind=2
tabs clearall
dump
tabs set "1"
tabs set "2"
tabs set "3"
tabs set "4"
tabs set "5"
tabs set "6"
tabs set "7"
tabs set "8"
tabs set "9"
tabs set "10"
tabs set "11"
tabs set "12"
tabs set "13"
tabs set "14"
tabs set "15"
tabs set "16"
tabs set "17"
expect notice "A paragraph holds at most 16 tab stops." Status
close
dump
